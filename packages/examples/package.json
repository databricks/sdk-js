{
  "name": "@databricks/sdk-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable examples for the Databricks JS SDK (not published)",
  "type": "module",
  "scripts": {
    "auth-and-errors": "node --import tsx/esm src/demos/auth-and-errors.ts",
    "full-demo": "node --import tsx/esm src/demos/full-demo.ts",
    "profile-resolution": "node --import tsx/esm src/profile-resolution.ts",
    "auth-strategies": "node --import tsx/esm src/auth-strategies.ts",
    "pagination": "node --import tsx/esm src/pagination.ts",
    "long-running-operations": "node --import tsx/esm src/long-running-operations.ts",
    "streaming-upload": "node --import tsx/esm src/streaming-upload.ts",
    "sql-execution": "node --import tsx/esm src/sql-execution.ts",
    "well-known-types": "node --import tsx/esm src/well-known-types.ts",
    "oneof": "node --import tsx/esm src/oneof.ts",
    "field-mask": "node --import tsx/esm src/field-mask.ts",
    "build": "echo 'nothing to build'",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:browser": "echo 'skipped'",
    "typecheck": "tsc --noEmit",
    "clean": "echo 'nothing to clean'"
  },
  "dependencies": {
    "@databricks/sdk-auth": "*",
    "@databricks/sdk-core": "*",
    "@databricks/sdk-files": "*",
    "@databricks/sdk-options": "*",
    "@databricks/sdk-postgres": "*",
    "@databricks/sdk-statementexecution": "*",
    "@databricks/sdk-uc-catalogs": "*",
    "@databricks/sdk-warehouses": "*"
  },
  "devDependencies": {
    "tsx": "^4.0.0"
  }
}
