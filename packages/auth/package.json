{
  "name": "@databricks/sdk-auth",
  "version": "0.1.0-dev.4",
  "description": "Databricks authentication library for JavaScript/TypeScript",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {"types": "./dist/index.d.ts", "default": "./dist/index.js"},
      "require": {"types": "./dist/index.d.cts", "default": "./dist/index.cjs"}
    },
    "./credentials": {
      "import": {"types": "./dist/credentials/index.d.ts", "default": "./dist/credentials/index.js"},
      "require": {"types": "./dist/credentials/index.d.cts", "default": "./dist/credentials/index.cjs"}
    },
    "./credentials/browser": {
      "import": {"types": "./dist/credentials/index.browser.d.ts", "default": "./dist/credentials/index.browser.js"},
      "require": {"types": "./dist/credentials/index.browser.d.cts", "default": "./dist/credentials/index.browser.cjs"}
    },
    "./oidc": {
      "import": {"types": "./dist/oidc/index.d.ts", "default": "./dist/oidc/index.js"},
      "require": {"types": "./dist/oidc/index.d.cts", "default": "./dist/oidc/index.cjs"}
    },
    "./oidc/browser": {
      "import": {"types": "./dist/oidc/index.browser.d.ts", "default": "./dist/oidc/index.browser.js"},
      "require": {"types": "./dist/oidc/index.browser.d.cts", "default": "./dist/oidc/index.browser.cjs"}
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.config.browser.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "author": "Databricks",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@databricks/sdk-core": ">=0.1.0-dev.5 <1.0.0",
    "zod": "^4.3.6"
  }
}
