{
  "name": "@databricks/sdk-options",
  "version": "0.1.0-dev.4",
  "description": "Options for configuring Databricks API clients and individual calls.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./client": {
      "import": {"types": "./dist/client/index.d.ts", "default": "./dist/client/index.js"},
      "require": {"types": "./dist/client/index.d.cts", "default": "./dist/client/index.cjs"}
    },
    "./call": {
      "import": {"types": "./dist/call/index.d.ts", "default": "./dist/call/index.js"},
      "require": {"types": "./dist/call/index.d.cts", "default": "./dist/call/index.cjs"}
    },
    "./lro": {
      "import": {"types": "./dist/lro/index.d.ts", "default": "./dist/lro/index.js"},
      "require": {"types": "./dist/lro/index.d.cts", "default": "./dist/lro/index.cjs"}
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.config.browser.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "author": "Databricks",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@databricks/sdk-auth": ">=0.1.0-dev.4 <1.0.0",
    "@databricks/sdk-core": ">=0.1.0-dev.5 <1.0.0"
  }
}
