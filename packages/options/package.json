{
  "name": "@databricks/sdk-options",
  "version": "0.0.0",
  "description": "Options for configuring Databricks API clients and individual calls.",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./call": {
      "types": "./dist/call/index.d.ts",
      "import": "./dist/call/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.config.browser.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "author": "Databricks",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@databricks/sdk-auth": ">=0.0.0 <1.0.0",
    "@databricks/sdk-core": ">=0.1.0-dev.1 <1.0.0"
  }
}
