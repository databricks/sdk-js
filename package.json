{
  "name": "sdk-js",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Databricks Modular SDKs for JavaScript",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/auth -w packages/databricks && npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:browser": "npm run test:browser --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "clean": "npm run clean --workspaces"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/databricks/sdk-js.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "22.19.12",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.0",
    "vite": "^6.4.0",
    "eslint-config-prettier": "^9.1.0",
    "playwright": "^1.48.0",
    "prettier": "^3.2.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "rollup": "4.59.0",
    "ws": "8.19.0",
    "picomatch": "4.0.3",
    "get-tsconfig": "4.13.6",
    "ts-api-utils": "2.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
